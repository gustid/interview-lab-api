{
  "info": {
    "_postman_id": "8e0f242b-a886-4d26-a890-cb1ad45b62bb",
    "name": "InterviewLab API",
    "description": "Complete Postman collection for the InterviewLab API. Run requests in collection order to register/login, create a candidate, create and manage an interview, and clean up test data. Login, candidate creation, and interview creation automatically save their returned values as collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "demo@interviewlab.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "SecurePassword123!",
      "type": "string"
    },
    {
      "key": "name",
      "value": "Demo User",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "candidateId",
      "value": "",
      "type": "string"
    },
    {
      "key": "interviewId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"name\": \"{{name}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Registers the collection user. A repeated run may return 409 if this user already exists; continue with Login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registered or already exists', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Authenticates the user and saves accessToken for all protected requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.expect(response.accessToken).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', response.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Returns the user represented by the current Bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Candidates",
      "item": [
        {
          "name": "Create Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane.doe.{{$timestamp}}@example.com\",\n  \"role\": \"Senior Backend Engineer\",\n  \"notes\": \"Preparing for a staff-level role\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/candidates",
            "description": "Creates a candidate owned by the authenticated user and saves candidateId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.expect(response.id).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('candidateId', response.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Candidates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "candidates"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "Returns candidates owned by the authenticated user with pagination."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate list returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.data).to.be.an('array');",
                  "  pm.expect(response.pagination).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Candidate",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/candidates/{{candidateId}}",
            "description": "Returns the candidate stored in candidateId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('candidateId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Candidate",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane.updated.{{$timestamp}}@example.com\",\n  \"role\": \"Staff Backend Engineer\",\n  \"notes\": \"Candidate details updated through PUT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/candidates/{{candidateId}}",
            "description": "Fully replaces the editable candidate representation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().role).to.eql('Staff Backend Engineer');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Interviews",
      "item": [
        {
          "name": "Create Interview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": \"{{candidateId}}\",\n  \"title\": \"Backend Architecture Interview\",\n  \"scheduledAt\": \"2026-08-01T10:00:00.000Z\",\n  \"durationMinutes\": 90,\n  \"type\": \"BACKEND\",\n  \"difficulty\": \"SENIOR\",\n  \"technologies\": [\n    \"NestJS\",\n    \"PostgreSQL\",\n    \"Docker\"\n  ],\n  \"notes\": \"Focus on API and database design\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/interviews",
            "description": "Creates an interview for candidateId and saves interviewId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Interview created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.expect(response.status).to.eql('SCHEDULED');",
                  "pm.collectionVariables.set('interviewId', response.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Interviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interviews?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "SCHEDULED",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "BACKEND",
                  "disabled": true
                },
                {
                  "key": "candidateId",
                  "value": "{{candidateId}}",
                  "disabled": true
                },
                {
                  "key": "dateFrom",
                  "value": "2026-01-01T00:00:00.000Z",
                  "disabled": true
                },
                {
                  "key": "dateTo",
                  "value": "2026-12-31T23:59:59.999Z",
                  "disabled": true
                }
              ]
            },
            "description": "Returns owned interviews. Optional filters are included but disabled; enable them as needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Interview list returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.data).to.be.an('array');",
                  "  pm.expect(response.pagination).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Interview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/interviews/{{interviewId}}",
            "description": "Returns the interview stored in interviewId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Interview returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('interviewId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Interview",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": \"{{candidateId}}\",\n  \"title\": \"Updated System Design Interview\",\n  \"scheduledAt\": \"2026-08-02T11:00:00.000Z\",\n  \"durationMinutes\": 60,\n  \"type\": \"SYSTEM_DESIGN\",\n  \"difficulty\": \"EXPERT\",\n  \"technologies\": [\n    \"PostgreSQL\",\n    \"Distributed Systems\"\n  ],\n  \"notes\": \"Updated interview plan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/interviews/{{interviewId}}",
            "description": "Fully replaces editable interview details without changing status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Interview updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.title).to.eql('Updated System Design Interview');",
                  "  pm.expect(response.status).to.eql('SCHEDULED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Interview",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/interviews/{{interviewId}}/complete",
            "description": "Atomically transitions an owned SCHEDULED interview to COMPLETED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Interview completed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.status).to.eql('COMPLETED');",
                  "  pm.expect(response.completedAt).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Feedback",
      "description": "Feedback can only be recorded after the interview has been completed.",
      "item": [
        {
          "name": "Create Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"overallScore\": 8,\n  \"technicalScore\": 9,\n  \"communicationScore\": 8,\n  \"problemSolvingScore\": 8,\n  \"strengths\": \"Strong API design and database reasoning\",\n  \"improvementAreas\": \"Could explain distributed-system tradeoffs more precisely\",\n  \"recommendation\": \"HIRE\",\n  \"additionalNotes\": \"Good overall performance\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/interviews/{{interviewId}}/feedback",
            "description": "Creates the single feedback record for the completed interview."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feedback created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.interviewId).to.eql(pm.collectionVariables.get('interviewId'));",
                  "  pm.expect(response.recommendation).to.eql('HIRE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Feedback",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/interviews/{{interviewId}}/feedback",
            "description": "Returns the feedback associated with the current interview."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feedback returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.interviewId).to.eql(pm.collectionVariables.get('interviewId'));",
                  "  pm.expect(response.overallScore).to.be.within(1, 10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Feedback",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"overallScore\": 9,\n  \"technicalScore\": 9,\n  \"communicationScore\": 9,\n  \"problemSolvingScore\": 8,\n  \"strengths\": \"Strong architecture, API design, and communication\",\n  \"improvementAreas\": \"Could provide more detail about failure recovery\",\n  \"recommendation\": \"STRONG_HIRE\",\n  \"additionalNotes\": \"Feedback updated after review\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/interviews/{{interviewId}}/feedback",
            "description": "Fully replaces the feedback for the completed interview."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feedback updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.overallScore).to.eql(9);",
                  "  pm.expect(response.recommendation).to.eql('STRONG_HIRE');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Cleanup",
      "description": "Run these after the main flow. Deleting an interview first is required because candidate deletion is restricted while interview history exists.",
      "item": [
        {
          "name": "Delete Interview",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/interviews/{{interviewId}}",
            "description": "Deletes the current interview. Any associated feedback would cascade."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Interview deleted', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "pm.collectionVariables.set('interviewId', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Candidate",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/candidates/{{candidateId}}",
            "description": "Deletes the current candidate after their interview has been removed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate deleted', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "pm.collectionVariables.set('candidateId', '');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
